using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Authorization;
using Microsoft.EntityFrameworkCore;
using System.Security.Claims;
using Bim.Server.Data;
using Bim.Server.Models;
using Bim.Server.Models.DTOs;
using Bim.Server.Services;

namespace Bim.Server.Controllers
{
    [Authorize]
    [ApiController]
    [Route("api/[controller]")]
    public class AnnotationsController : ControllerBase    {
        private readonly ApplicationDbContext _context;
        // private readonly INotificationService _notificationService;
        private readonly ILogger<AnnotationsController> _logger;

        public AnnotationsController(
            ApplicationDbContext context,
            // INotificationService notificationService,
            ILogger<AnnotationsController> logger)
        {
            _context = context;
            // _notificationService = notificationService;
            _logger = logger;
        }

        /// <summary>
        /// Obtenir toutes les annotations d'un projet
        /// </summary>
        [HttpGet("project/{projectId}")]
        public async Task<ActionResult<List<AnnotationDto>>> GetProjectAnnotations(int projectId)
        {
            try
            {
                var annotations = await _context.Annotations
                    .Where(a => a.ProjectId == projectId && a.Status == "active")
                    .Include(a => a.Author)
                    .Include(a => a.Replies)
                        .ThenInclude(r => r.Author)
                    .OrderByDescending(a => a.CreatedAt)
                    .Select(a => new AnnotationDto
                    {
                        Id = a.Id,
                        Content = a.Content,
                        AuthorId = a.AuthorId,
                        AuthorName = $"{a.Author.FirstName} {a.Author.LastName}".Trim(),
                        AuthorEmail = a.Author.Email ?? "",
                        ProjectId = a.ProjectId,
                        PositionX = a.PositionX,
                        PositionY = a.PositionY,
                        PositionZ = a.PositionZ,
                        CameraX = a.CameraX,
                        CameraY = a.CameraY,
                        CameraZ = a.CameraZ,
                        TargetElementId = a.TargetElementId,
                        AnnotationType = a.AnnotationType,
                        Style = a.Style,
                        CreatedAt = a.CreatedAt,
                        UpdatedAt = a.UpdatedAt,
                        Status = a.Status,
                        ParentAnnotationId = a.ParentAnnotationId,
                        IsPublic = a.IsPublic,
                        Replies = a.Replies.Where(r => r.Status == "active").Select(r => new AnnotationDto
                        {
                            Id = r.Id,
                            Content = r.Content,
                            AuthorId = r.AuthorId,
                            AuthorName = $"{r.Author.FirstName} {r.Author.LastName}".Trim(),
                            AuthorEmail = r.Author.Email ?? "",
                            ProjectId = r.ProjectId,
                            PositionX = r.PositionX,
                            PositionY = r.PositionY,
                            PositionZ = r.PositionZ,
                            AnnotationType = r.AnnotationType,
                            Style = r.Style,
                            CreatedAt = r.CreatedAt,
                            UpdatedAt = r.UpdatedAt,
                            Status = r.Status,
                            ParentAnnotationId = r.ParentAnnotationId,
                            IsPublic = r.IsPublic
                        }).ToList()
                    })
                    .ToListAsync();

                return Ok(annotations);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error retrieving annotations for project {ProjectId}", projectId);
                return StatusCode(500, new { message = "Erreur lors de la récupération des annotations" });
            }
        }

        /// <summary>
        /// Obtenir une annotation spécifique
        /// </summary>
        [HttpGet("{id}")]
        public async Task<ActionResult<AnnotationDto>> GetAnnotation(int id)
        {
            try
            {
                var annotation = await _context.Annotations
                    .Include(a => a.Author)
                    .Include(a => a.Replies)
                        .ThenInclude(r => r.Author)
                    .Where(a => a.Id == id)
                    .Select(a => new AnnotationDto
                    {
                        Id = a.Id,
                        Content = a.Content,
                        AuthorId = a.AuthorId,
                        AuthorName = $"{a.Author.FirstName} {a.Author.LastName}".Trim(),
                        AuthorEmail = a.Author.Email ?? "",
                        ProjectId = a.ProjectId,
                        PositionX = a.PositionX,
                        PositionY = a.PositionY,
                        PositionZ = a.PositionZ,
                        CameraX = a.CameraX,
                        CameraY = a.CameraY,
                        CameraZ = a.CameraZ,
                        TargetElementId = a.TargetElementId,
                        AnnotationType = a.AnnotationType,
                        Style = a.Style,
                        CreatedAt = a.CreatedAt,
                        UpdatedAt = a.UpdatedAt,
                        Status = a.Status,
                        ParentAnnotationId = a.ParentAnnotationId,
                        IsPublic = a.IsPublic,
                        Replies = a.Replies.Where(r => r.Status == "active").Select(r => new AnnotationDto
                        {
                            Id = r.Id,
                            Content = r.Content,
                            AuthorId = r.AuthorId,
                            AuthorName = $"{r.Author.FirstName} {r.Author.LastName}".Trim(),
                            AuthorEmail = r.Author.Email ?? "",
                            ProjectId = r.ProjectId,
                            PositionX = r.PositionX,
                            PositionY = r.PositionY,
                            PositionZ = r.PositionZ,
                            AnnotationType = r.AnnotationType,
                            Style = r.Style,
                            CreatedAt = r.CreatedAt,
                            UpdatedAt = r.UpdatedAt,
                            Status = r.Status,
                            ParentAnnotationId = r.ParentAnnotationId,
                            IsPublic = r.IsPublic
                        }).ToList()
                    })
                    .FirstOrDefaultAsync();

                if (annotation == null)
                {
                    return NotFound(new { message = "Annotation non trouvée" });
                }

                return Ok(annotation);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error retrieving annotation {AnnotationId}", id);
                return StatusCode(500, new { message = "Erreur lors de la récupération de l'annotation" });
            }
        }

        /// <summary>
        /// Créer une nouvelle annotation
        /// </summary>
        [HttpPost]
        public async Task<ActionResult<AnnotationDto>> CreateAnnotation([FromBody] CreateAnnotationDto createDto)
        {
            try
            {
                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (string.IsNullOrEmpty(userId))
                {
                    return Unauthorized();
                }

                // Vérifier que le projet existe
                var project = await _context.Projects.FindAsync(createDto.ProjectId);
                if (project == null)
                {
                    return NotFound(new { message = "Projet non trouvé" });
                }

                var annotation = new Annotation
                {
                    Content = createDto.Content,
                    AuthorId = userId,
                    ProjectId = createDto.ProjectId,
                    PositionX = createDto.PositionX,
                    PositionY = createDto.PositionY,
                    PositionZ = createDto.PositionZ,
                    CameraX = createDto.CameraX,
                    CameraY = createDto.CameraY,
                    CameraZ = createDto.CameraZ,
                    TargetElementId = createDto.TargetElementId,
                    AnnotationType = createDto.AnnotationType,
                    Style = createDto.Style,
                    IsPublic = createDto.IsPublic,
                    ParentAnnotationId = string.IsNullOrEmpty(createDto.ParentAnnotationId) ? null : createDto.ParentAnnotationId,
                    CreatedAt = DateTime.UtcNow,
                    Status = "active"
                };

                _context.Annotations.Add(annotation);
                await _context.SaveChangesAsync();

                // Charger l'annotation avec les données de l'auteur
                var createdAnnotation = await _context.Annotations
                    .Include(a => a.Author)
                    .Where(a => a.Id == annotation.Id)
                    .Select(a => new AnnotationDto
                    {
                        Id = a.Id,
                        Content = a.Content,
                        AuthorId = a.AuthorId,
                        AuthorName = $"{a.Author.FirstName} {a.Author.LastName}".Trim(),
                        AuthorEmail = a.Author.Email ?? "",
                        ProjectId = a.ProjectId,
                        PositionX = a.PositionX,
                        PositionY = a.PositionY,
                        PositionZ = a.PositionZ,
                        CameraX = a.CameraX,
                        CameraY = a.CameraY,
                        CameraZ = a.CameraZ,
                        TargetElementId = a.TargetElementId,
                        AnnotationType = a.AnnotationType,
                        Style = a.Style,
                        CreatedAt = a.CreatedAt,
                        UpdatedAt = a.UpdatedAt,
                        Status = a.Status,
                        ParentAnnotationId = a.ParentAnnotationId,
                        IsPublic = a.IsPublic,
                        Replies = new List<AnnotationDto>()
                    })
                    .FirstAsync();                // Envoyer une notification si ce n'est pas une réponse
                if (string.IsNullOrEmpty(createDto.ParentAnnotationId))
                {
                    // await _notificationService.NotifyAnnotationCreatedAsync(annotation.Id, createDto.ProjectId, userId);
                }

                _logger.LogInformation("Annotation created successfully: {AnnotationId} by user {UserId}", annotation.Id, userId);

                return CreatedAtAction(nameof(GetAnnotation), new { id = annotation.Id }, createdAnnotation);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error creating annotation");
                return StatusCode(500, new { message = "Erreur lors de la création de l'annotation" });
            }
        }

        /// <summary>
        /// Mettre à jour une annotation
        /// </summary>
        [HttpPut("{id}")]
        public async Task<ActionResult<AnnotationDto>> UpdateAnnotation(int id, [FromBody] UpdateAnnotationDto updateDto)
        {
            try
            {
                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (string.IsNullOrEmpty(userId))
                {
                    return Unauthorized();
                }

                var annotation = await _context.Annotations
                    .Include(a => a.Author)
                    .FirstOrDefaultAsync(a => a.Id == id);

                if (annotation == null)
                {
                    return NotFound(new { message = "Annotation non trouvée" });
                }

                // Vérifier que l'utilisateur est l'auteur ou un admin
                var userRoles = User.FindAll(ClaimTypes.Role).Select(c => c.Value);
                if (annotation.AuthorId != userId && !userRoles.Contains("Admin"))
                {
                    return Forbid("Vous n'êtes pas autorisé à modifier cette annotation");
                }

                // Mettre à jour les champs fournis
                if (!string.IsNullOrEmpty(updateDto.Content))
                    annotation.Content = updateDto.Content;

                if (!string.IsNullOrEmpty(updateDto.Status))
                    annotation.Status = updateDto.Status;

                if (!string.IsNullOrEmpty(updateDto.Style))
                    annotation.Style = updateDto.Style;

                if (updateDto.IsPublic.HasValue)
                    annotation.IsPublic = updateDto.IsPublic.Value;

                annotation.UpdatedAt = DateTime.UtcNow;

                await _context.SaveChangesAsync();

                // Retourner l'annotation mise à jour
                var updatedAnnotation = await _context.Annotations
                    .Include(a => a.Author)
                    .Include(a => a.Replies)
                        .ThenInclude(r => r.Author)
                    .Where(a => a.Id == id)
                    .Select(a => new AnnotationDto
                    {
                        Id = a.Id,
                        Content = a.Content,
                        AuthorId = a.AuthorId,
                        AuthorName = $"{a.Author.FirstName} {a.Author.LastName}".Trim(),
                        AuthorEmail = a.Author.Email ?? "",
                        ProjectId = a.ProjectId,
                        PositionX = a.PositionX,
                        PositionY = a.PositionY,
                        PositionZ = a.PositionZ,
                        CameraX = a.CameraX,
                        CameraY = a.CameraY,
                        CameraZ = a.CameraZ,
                        TargetElementId = a.TargetElementId,
                        AnnotationType = a.AnnotationType,
                        Style = a.Style,
                        CreatedAt = a.CreatedAt,
                        UpdatedAt = a.UpdatedAt,
                        Status = a.Status,
                        ParentAnnotationId = a.ParentAnnotationId,
                        IsPublic = a.IsPublic,
                        Replies = a.Replies.Where(r => r.Status == "active").Select(r => new AnnotationDto
                        {
                            Id = r.Id,
                            Content = r.Content,
                            AuthorId = r.AuthorId,
                            AuthorName = $"{r.Author.FirstName} {r.Author.LastName}".Trim(),
                            AuthorEmail = r.Author.Email ?? "",
                            ProjectId = r.ProjectId,
                            PositionX = r.PositionX,
                            PositionY = r.PositionY,
                            PositionZ = r.PositionZ,
                            AnnotationType = r.AnnotationType,
                            Style = r.Style,
                            CreatedAt = r.CreatedAt,
                            UpdatedAt = r.UpdatedAt,
                            Status = r.Status,
                            ParentAnnotationId = r.ParentAnnotationId,
                            IsPublic = r.IsPublic
                        }).ToList()
                    })
                    .FirstAsync();

                _logger.LogInformation("Annotation updated successfully: {AnnotationId} by user {UserId}", id, userId);

                return Ok(updatedAnnotation);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error updating annotation {AnnotationId}", id);
                return StatusCode(500, new { message = "Erreur lors de la mise à jour de l'annotation" });
            }
        }

        /// <summary>
        /// Supprimer une annotation (soft delete)
        /// </summary>
        [HttpDelete("{id}")]
        public async Task<ActionResult> DeleteAnnotation(int id)
        {
            try
            {
                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (string.IsNullOrEmpty(userId))
                {
                    return Unauthorized();
                }

                var annotation = await _context.Annotations.FindAsync(id);
                if (annotation == null)
                {
                    return NotFound(new { message = "Annotation non trouvée" });
                }

                // Vérifier que l'utilisateur est l'auteur ou un admin
                var userRoles = User.FindAll(ClaimTypes.Role).Select(c => c.Value);
                if (annotation.AuthorId != userId && !userRoles.Contains("Admin"))
                {
                    return Forbid("Vous n'êtes pas autorisé à supprimer cette annotation");
                }

                // Soft delete
                annotation.Status = "archived";
                annotation.UpdatedAt = DateTime.UtcNow;

                await _context.SaveChangesAsync();

                _logger.LogInformation("Annotation deleted successfully: {AnnotationId} by user {UserId}", id, userId);

                return Ok(new { message = "Annotation supprimée avec succès" });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error deleting annotation {AnnotationId}", id);
                return StatusCode(500, new { message = "Erreur lors de la suppression de l'annotation" });
            }
        }

        /// <summary>
        /// Marquer une annotation comme résolue
        /// </summary>
        [HttpPost("{id}/resolve")]
        public async Task<ActionResult> ResolveAnnotation(int id)
        {
            try
            {
                var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                if (string.IsNullOrEmpty(userId))
                {
                    return Unauthorized();
                }

                var annotation = await _context.Annotations.FindAsync(id);
                if (annotation == null)
                {
                    return NotFound(new { message = "Annotation non trouvée" });
                }

                annotation.Status = "resolved";
                annotation.UpdatedAt = DateTime.UtcNow;

                await _context.SaveChangesAsync();

                _logger.LogInformation("Annotation resolved: {AnnotationId} by user {UserId}", id, userId);

                return Ok(new { message = "Annotation marquée comme résolue" });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error resolving annotation {AnnotationId}", id);
                return StatusCode(500, new { message = "Erreur lors de la résolution de l'annotation" });
            }
        }
    }
}
